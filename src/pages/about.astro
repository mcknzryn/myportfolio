---
import { Image } from "astro:assets";
import headshot from "../assets/profile/headshot.jpeg";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "bio & cv";
---

<BaseLayout title="Bio & CV" mode="document">
  <div class="container">
    <h1 id="pagetitle">{pageTitle}</h1>
    <div id="bio">
      <p>
        <b class="bio-name"><i>McKenzie Ryan</i></b> is a lifestyle photographer based
        in New York City working across digital and analog mediums. Originally from
        the Midwest and shaped by her time in California, McKenzie brings a refined
        eye to commercial work. Her practice bridges documentary and editorial approaches,
        creating carefully composed imagery rooted in authentic storytelling, intentional
        light, and curated aesthetics.
      </p>
      <Image
        src={headshot}
        alt="Portrait of McKenzie Ryan"
        widths={[300, 600]}
        sizes="(max-width: 800px) min(100vw - 3rem, 300px), 300px"
        loading="eager"
      />
    </div>

    <div id="cv">
      <h1>bio & cv</h1>
      <ul class="education">
        <li><h3>Education</h3></li>
        <li>University of California San Diego, 2022-2024</li>
        <li>University of Iowa, 2019-2021</li>
      </ul>
      <br />
      <ul class="exhibitions">
        <li><h3>Exhibitions</h3></li>
        <li>Flora and Fauna Photo Exhibition, Price Center, San Diego, 2024</li>
        <li>
          Mixed Media in Studio Exhibition, Adam D. Kamil Gallery, San Diego,
          2023
        </li>
        <li>
          Black & White Analog Photo Gallery, Vafhalla Gallery, San Diego, 2023
        </li>
        <li>Framing Yosemite Photo Gallery, Green Room, Upland, 2021</li>
        <li>Baseball Short Film Screening, Phoenix Theater, Iowa, 2018</li>
        <li>One Band Short Film Screening, Phoenix Theater, Iowa, 2017</li>
      </ul>
      <br />
      <ul class="awards">
        <li><h3>Awards</h3></li>
        <li>Finalist, Mary Thomas Prappas Ethics Essay Contest, 2021</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    font-family: inherit;
    font-size: clamp(0.875rem, 1.2vw, 1rem);
    padding: 1.5rem 0 1.5rem;
  }

  .bio-name {
    font-weight: 700;
  }

  #pagetitle {
    margin: 0;
    padding: 0 0 1.75rem;
    width: 100%;
    max-width: 100%;
    white-space: normal;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 0.9;
  }

  #bio,
  #cv {
    min-width: 0;
  }

  #bio p {
    max-width: 100%;
    margin: 0;
    text-align: left;
  }

  #bio img {
    display: block;
    width: min(100%, 300px);
    height: auto;
    margin-top: 1.875rem;
  }

  #cv {
    padding-bottom: 1rem;
    text-align: left;
  }

  #cv h1 {
    display: none;
  }

  #cv ul {
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  #cv h3 {
    margin: 0 0 0.15rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  #cv li {
    margin-top: 0.1rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 801px) {
    .container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 8vw, 8rem);
      padding-right: 0;
    }

    #cv {
      grid-column: 2;
    }

    #bio {
      grid-column: 1;
      grid-row: 1;
    }

    #cv {
      padding-top: clamp(1rem, 8vw, 10rem);
      text-align: right;
    }

    #pagetitle {
      display: none;
    }

    #cv h1 {
      display: block;
      margin: 0 0 clamp(2rem, 4vw, 4rem);
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      line-height: 0.9;
      text-align: right;
    }
  }

  @media (max-width: 800px) {
    .container {
      gap: 1.5rem;
    }

    #bio img {
      margin-top: 1.25rem;
    }

    #cv {
      padding-bottom: 0;
    }
  }

  @media (min-width: 1200px) {
    .container {
      grid-template-columns: minmax(0, 450px) minmax(0, 600px);
      justify-content: space-between;
      font-size: 0.75rem;
    }

    #cv h1 {
      margin: 0 0 4rem;
      font-size: 2.5rem;
    }

    #cv h3 {
      font-size: 0.875rem;
    }
  }
</style>
