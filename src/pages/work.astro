---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";

const pageTitle = "Work";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

// Keep the production arrangement easy to edit while allowing Arrange mode to
// generate the next version of this list visually.
const galleryOrder = [
  "29", "16", "01", "20", "34", "13", "00", "41", "35", "25", "46", "99", "22", "18", "26", "45", "09", "44", "23", "15", "11", "42", "02", "28", "10", "32", "06", "30", "31", "14", "12", "17", "37"
];

// Arrange mode keeps these images at the front when randomized. New images
// are non-favorites until they are explicitly marked in Arrange mode.
const galleryFavorites = [];
const galleryPinned = [];

const imagesById = new Map(
  Object.entries(imageModules).map(([path, module]) => {
    const id = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    return [id, { image: module.default, alt: id.replace(/[-_]/g, " ") }];
  }),
);

const allImageIds = [...imagesById.keys()].sort((first, second) => first.localeCompare(second));
const orderedImageIds = [
  ...galleryOrder.filter((id) => imagesById.has(id)),
  ...allImageIds.filter((id) => !galleryOrder.includes(id)),
];

const gallery = orderedImageIds.map((id) => ({ id, ...imagesById.get(id)! }));
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true}>
  <main class="work-page">

    <section
      class="gallery"
      aria-label="Selected photography gallery"
      data-gallery-favorites={import.meta.env.DEV ? JSON.stringify(galleryFavorites) : undefined}
      data-gallery-pinned={import.meta.env.DEV ? JSON.stringify(galleryPinned) : undefined}
    >
      {gallery.map((item) => (
        <figure class="gallery-item" data-image-id={item.id}>
          <Image
            src={item.image}
            alt={item.alt}
            draggable={false}
            sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 25vw"
            loading="lazy"
          />
        </figure>
      ))}
    </section>

  </main>
</BaseLayout>

{import.meta.env.DEV && <script src="../scripts/gallery-arrange.js"></script>}

<style>
  .work-page {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .gallery {
    column-count: 3;
    column-gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-item {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background: #f2f2f2;
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    touch-action: pan-y;
  }

  .gallery-item.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  :global(body.arrange-mode) .gallery-item {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(body.arrange-mode) .gallery {
    position: relative;
    display: block;
    min-height: 1px;
    column-count: initial;
    column-gap: 0;
  }

  :global(body.arrange-mode) .gallery-item {
    width: calc((100% - 3rem) / 3);
    margin: 0;
  }

  :global(body.arrange-mode) .gallery-item.is-dragging {
    cursor: grabbing;
  }

  :global(.gallery-placeholder) {
    visibility: hidden;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    background: #f2f2f2;
  }

  :global(.arrange-toolbar) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  :global(.arrange-favorite-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font: 1.25rem/1 sans-serif;
    cursor: pointer;
  }

  :global(.arrange-favorite-button.is-active) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-favorite-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-pin-button) {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font: 1rem/1 sans-serif;
    cursor: pointer;
  }

  :global(.arrange-pin-button.is-active) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-pin-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.gallery.is-overview) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 0.75rem;
    column-count: initial;
  }

  :global(.gallery.is-overview) .gallery-item {
    aspect-ratio: 1 / 1;
    margin: 0;
  }

  :global(.gallery.is-overview) .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.arrange-toolbar button) {
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    padding: 0.5rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  :global(.arrange-toolbar button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-output) {
    width: min(100%, 42rem);
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid #999;
    background: #fafafa;
    color: #000;
    font: 0.8rem/1.4 monospace;
    resize: vertical;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 320ms ease-in-out; 
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .work-page {
      padding-top: 0.5rem;
    }

    .gallery {
      column-count: 2;
      column-gap: 1.5rem;
    }

    .gallery-item {
      margin-bottom: 1.5rem;
    }

    :global(body.arrange-mode) .gallery-item {
      width: calc((100% - 1.5rem) / 2);
    }

    :global(.gallery-placeholder) {
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .work-page {
      padding: 0.5rem 0 2rem;
    }

    .gallery {
      column-count: 1;
    }

    .gallery-item {
      margin-bottom: 1.25rem;
    }

    :global(body.arrange-mode) .gallery-item {
      width: 100%;
    }

    :global(.gallery-placeholder) {
      margin-bottom: 1.25rem;
    }
  }
</style>
