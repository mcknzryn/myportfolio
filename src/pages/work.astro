---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";

const pageTitle = "Work";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const gallery = Object.entries(imageModules)
  .sort(([first], [second]) => first.localeCompare(second))
  .map(([path, module]) => {
    const filename = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    const alt = filename.replace(/[-_]/g, " ");

    return { image: module.default, alt };
  });
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true}>
  <main class="work-page">

    <section class="gallery" aria-label="Selected photography gallery">
      {gallery.map((item) => (
        <figure class="gallery-item">
          <Image
            src={item.image}
            alt={item.alt}
            sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 25vw"
            loading="lazy"
          />
        </figure>
      ))}
    </section>

  </main>
</BaseLayout>

<style>
  .work-page {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 5rem;
  }

  .gallery {
    column-count: 4;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gallery-item {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background: #f2f2f2;
    break-inside: avoid;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 320ms ease-in-out; 
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .work-page {
      padding-top: 1.5rem;
    }

    .gallery {
      column-count: 2;
      column-gap: 1.5rem;
    }

    .gallery-item {
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .work-page {
      padding: 1.25rem 0.75rem 6rem;
    }

    .gallery {
      column-count: 1;
    }

    .gallery-item {
      margin-bottom: 1.25rem;
    }
  }
</style>
