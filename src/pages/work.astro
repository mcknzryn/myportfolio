---
import WorkGallery from "../components/WorkGallery.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Work";
---

<BaseLayout title={title} mode="document">
  <div class="work-page">
    <WorkGallery />
  </div>
</BaseLayout>

<style>
  .work-page {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
  }

  @media (max-width: 800px) {
    .work-page {
      padding-bottom: 1.5rem;
    }
  }
</style>
