---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";

const pageTitle = "Work";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const gallery = Object.entries(imageModules)
  .sort(([first], [second]) => first.localeCompare(second))
  .map(([path, module]) => {
    const filename = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    const alt = filename.replace(/[-_]/g, " ");

    return { image: module.default, alt };
  });
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true}>
  <main class="work-page">

    <section class="gallery" aria-label="Selected photography gallery">
      {gallery.map((item) => (
        <figure class="gallery-item">
          <Image
            src={item.image}
            alt={item.alt}
            sizes="(max-width: 700px) 50vw, 16vw"
            loading="lazy"
          />
        </figure>
      ))}
    </section>

  </main>
</BaseLayout>

<style>
  .work-page {
    max-width: 1320px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4rem 3.75rem;
    align-items: start;
  }

  .gallery-item {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background: #f2f2f2;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 320ms ease-in-out; 
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .work-page {
      padding-top: 1.5rem;
    }

    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }

  }
</style>
