---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";

const pageTitle = "Work";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

// Keep the production arrangement easy to edit while allowing Arrange mode to
// generate the next version of these columns visually.
const galleryColumns = [
  ["29", "16", "01", "20", "34", "13", "00", "41", "35", "25", "46"],
  ["99", "22", "18", "26", "45", "09", "44", "23", "15", "11", "42"],
  ["02", "28", "10", "32", "06", "30", "31", "14", "12", "17", "37"],
];

// Arrange mode keeps these images at the front when randomized. New images
// are non-favorites until they are explicitly marked in Arrange mode.
const galleryFavorites: string[] = [];
const galleryPinned: string[] = [];

const imagesById = new Map(
  await Promise.all(Object.entries(imageModules).map(async ([path, module]) => {
    const id = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    const mobileImage = await getImage({
      src: module.default,
      widths: [320, 480, 640, 800],
      quality: 70,
      format: "webp",
    });

    return [id, {
      image: module.default,
      mobileImage,
      alt: id.replace(/[-_]/g, " "),
    }] as const;
  })),
);

const allImageIds = [...imagesById.keys()].sort((first, second) => first.localeCompare(second));
const configuredGalleryColumns = galleryColumns.map((column) => column.filter((id) => imagesById.has(id)));
const configuredGalleryIds = new Set(configuredGalleryColumns.flat());
const unplacedImageIds = allImageIds.filter((id) => !configuredGalleryIds.has(id));
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true}>
	<main class="work-page">

    <section
      class="gallery"
      aria-label="Selected photography gallery"
      data-gallery-favorites={import.meta.env.DEV ? JSON.stringify(galleryFavorites) : undefined}
      data-gallery-pinned={import.meta.env.DEV ? JSON.stringify(galleryPinned) : undefined}
      data-gallery-columns={import.meta.env.DEV ? JSON.stringify(configuredGalleryColumns) : undefined}
      data-gallery-unplaced={import.meta.env.DEV ? JSON.stringify(unplacedImageIds) : undefined}
    >
      {configuredGalleryColumns.map((column) => (
        <div class="gallery-column">
          {column.map((id) => {
            const item = imagesById.get(id)!;
            return (
              <figure class="gallery-item" data-image-id={id}>
                <picture>
                  <source
                    media="(max-width: 800px)"
                    srcset={item.mobileImage.srcSet.attribute}
                    sizes="30vw"
                    type="image/webp"
                  />
                  <Image
                    src={item.image}
                    alt={item.alt}
                    draggable={false}
                    sizes="(max-width: 900px) 30vw, 28vw"
                    loading="lazy"
                  />
                </picture>
              </figure>
            );
          })}
        </div>
      ))}
      {unplacedImageIds.length > 0 && (
        <div class="gallery-unplaced" aria-label="Unplaced gallery images">
          {unplacedImageIds.map((id) => {
            const item = imagesById.get(id)!;
            return (
              <figure class="gallery-item" data-image-id={id}>
                <picture>
                  <source
                    media="(max-width: 800px)"
                    srcset={item.mobileImage.srcSet.attribute}
                    sizes="30vw"
                    type="image/webp"
                  />
                  <Image
                    src={item.image}
                    alt={item.alt}
                    draggable={false}
                    sizes="(max-width: 900px) 30vw, 28vw"
                    loading="lazy"
                  />
                </picture>
              </figure>
            );
          })}
        </div>
      )}
    </section>

  </main>
</BaseLayout>

<script src="../scripts/gallery-reveal.js"></script>
{import.meta.env.DEV && <script src="../scripts/gallery-arrange.js"></script>}

<style>
  .work-page {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-unplaced {
    display: none;
  }

  .gallery-item {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background: #fff;
    break-inside: avoid;
    touch-action: pan-y;
  }

  :global(html.js) .gallery-item :global(img):not(.is-revealed) {
    opacity: 0;
  }

  .gallery-item.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  :global(body.arrange-mode) .gallery-item {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(body.arrange-mode) .gallery {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-height: 1px;
    column-count: initial;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  :global(body.arrange-mode) .gallery-column {
    position: relative;
    display: block;
    min-width: 0;
  }

  :global(body.arrange-mode) .gallery-item {
    width: 100%;
    margin: 0;
  }

  :global(body.arrange-mode) .gallery-item.is-dragging {
    cursor: grabbing;
  }

  :global(.arrange-toolbar) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  :global(.arrange-favorite-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font: var(--font-weight-book) 1.25rem/1 var(--font-family);
    cursor: pointer;
  }

  :global(.arrange-favorite-button.is-active) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-favorite-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-pin-button) {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font: var(--font-weight-book) 1rem/1 var(--font-family);
    cursor: pointer;
  }

  :global(.arrange-pin-button.is-active) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-pin-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.gallery.is-overview) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    column-count: initial;
  }

  :global(.gallery.is-overview) .gallery-item {
    aspect-ratio: 1 / 1;
    margin: 0;
  }

  :global(.gallery.is-overview) .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.arrange-toolbar button) {
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    padding: 0.5rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  :global(.arrange-toolbar button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-output) {
    width: min(100%, 42rem);
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid #999;
    background: #fafafa;
    color: #000;
    font: 0.8rem/1.4 monospace;
    resize: vertical;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-item :global(picture) {
    display: block;
  }

  .gallery-item :global(img).is-revealed {
    opacity: 1;
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @media (min-width: 801px) and (max-width: 1024px) {
    .work-page {
      padding-top: 3.5rem;
      padding-bottom: calc(3rem + var(--footer-height));
    }
  }

  @media (max-width: 800px) {
    .work-page {
      padding-bottom: 1.5rem;
    }
  }

</style>
