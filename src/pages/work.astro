---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { ImageMetadata } from "astro";

const pageTitle = "Work";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

// Keep the production arrangement easy to edit while allowing Arrange mode to
// generate the next version of this list visually.
const galleryOrder = [
  "29", "18", "26", "09", "22", "11", "32", "14", "12", "99", "13", "10", "06", "17", "15", "31", "01", "28", "02", "00", "16", "24", "30", "25", "23", "20"
];

const imagesById = new Map(
  Object.entries(imageModules).map(([path, module]) => {
    const id = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    return [id, { image: module.default, alt: id.replace(/[-_]/g, " ") }];
  }),
);

const allImageIds = [...imagesById.keys()].sort((first, second) => first.localeCompare(second));
const orderedImageIds = [
  ...galleryOrder.filter((id) => imagesById.has(id)),
  ...allImageIds.filter((id) => !galleryOrder.includes(id)),
];

const gallery = orderedImageIds.map((id) => ({ id, ...imagesById.get(id)! }));
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true}>
  <main class="work-page">

    <section class="gallery" aria-label="Selected photography gallery">
      {gallery.map((item) => (
        <figure class="gallery-item" data-image-id={item.id}>
          <Image
            src={item.image}
            alt={item.alt}
            draggable={false}
            sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 25vw"
            loading="lazy"
          />
        </figure>
      ))}
    </section>

  </main>
</BaseLayout>

<script src="../scripts/gallery-arrange.js"></script>

<style>
  .work-page {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .gallery {
    column-count: 3;
    column-gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-item {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background: #f2f2f2;
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    touch-action: pan-y;
  }

  .gallery-item.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  :global(body.arrange-mode) .gallery-item {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(body.arrange-mode) .gallery-item.is-dragging {
    cursor: grabbing;
  }

  :global(.gallery-placeholder) {
    visibility: hidden;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    background: #f2f2f2;
  }

  :global(.arrange-toolbar) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  :global(.arrange-toolbar button) {
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    padding: 0.5rem 0.75rem;
    font: inherit;
    cursor: pointer;
  }

  :global(.arrange-toolbar button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-output) {
    width: min(100%, 42rem);
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid #999;
    background: #fafafa;
    color: #000;
    font: 0.8rem/1.4 monospace;
    resize: vertical;
  }

  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 320ms ease-in-out; 
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .work-page {
      padding-top: 0.5rem;
    }

    .gallery {
      column-count: 2;
      column-gap: 1.5rem;
    }

    .gallery-item {
      margin-bottom: 1.5rem;
    }

    :global(.gallery-placeholder) {
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .work-page {
      padding: 0.5rem 0 2rem;
    }

    .gallery {
      column-count: 1;
    }

    .gallery-item {
      margin-bottom: 1.25rem;
    }

    :global(.gallery-placeholder) {
      margin-bottom: 1.25rem;
    }
  }
</style>
