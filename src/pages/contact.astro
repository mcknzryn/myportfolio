---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "contact";
---

<BaseLayout>
  <div class="container">
    <h1 id="pagetitle">{pageTitle}</h1>
    <div class="contact-content">
      <p>For all inquiries and requests: <a href="mailto:knockknock@mckenzieryan.co">hello@mckenzieryan.co</a></p>
      <p>More on Instagram: <a href="https://www.instagram.com/thisspotstaken/">@thisspotstaken</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 0 3.75rem;
    font-family: inherit;
    font-size: clamp(0.875rem, 1.2vw, 1rem);
  }

  #pagetitle {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    white-space: normal;
    font-family: 'Avenir Black';
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 0.9;
  }

  .contact-content {
    min-width: 0;
    max-width: 100%;
    text-align: left;
  }

  .contact-content p {
    margin: 0 0 1.25rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .container {
      gap: 0.75rem;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .container { padding-top: 1.5rem; }
  }

  @media (min-width: 1024px) {
    .container,
    #pagetitle,
    .contact-content {
      text-align: right;
    }
  }
</style>
