---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Contact" hidePageTitle={true}>
  <main class="contact-page">
    <h1>Contact</h1>
    <div class="contact-content">
      <p>For inquiries, collaborations, and print requests, get in touch.</p>
      <p><a href="mailto:knockknock@mckenzieryan.co">hello@mckenzieryan.co</a></p>
      <p><a href="https://www.instagram.com/thisspotstaken/">@thisspotstaken on Instagram</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(1rem, 5vw, 4rem) 0 4rem;
  }

  .contact-page h1 {
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: clamp(2rem, 6vw, 2.5rem);
    line-height: 0.9;
  }

  .contact-content {
    max-width: 32rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.35;
  }

  .contact-content p { margin: 0 0 1.25rem; }
  .contact-content a { text-underline-offset: 0.2em; }

  @media (max-width: 700px) {
    .contact-page {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 1.5rem;
    }
  }
</style>
