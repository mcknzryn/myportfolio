---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact";
const heading = "get in touch...";
---

<BaseLayout title={title} mode="document" contentLayout="centered-all">
  <div class="container">
    <h1 class="page-heading">{heading}</h1>
    <div class="contact-content">
      <div class="contact-line">
        For all inquiries and requests: <a
          href="mailto:knockknock@mckenzieryan.co">knockknock@mckenzieryan.co</a
        >
      </div>
      <div class="contact-line">
        More on Instagram: <a
          href="https://www.instagram.com/thisspotstaken/"
          target="_blank"
          rel="noopener noreferrer">@thisspotstaken</a
        >
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 1.5rem 0 1.5rem;
    font-family: inherit;
    font-size: clamp(0.875rem, 1.2vw, 1rem);
  }

  .page-heading,
  .contact-content h1,
  .contact-content h2,
  .contact-content h3 {
    line-height: 0.9;
  }

  .page-heading {
    margin: 0;
    padding: 0 0 1rem;
    width: 100%;
    max-width: 100%;
    white-space: normal;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .contact-content h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .contact-content h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .contact-content h3 {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .contact-content {
    min-width: 0;
    max-width: 100%;
  }

  .contact-line {
    margin: 0 0 1.25rem;
    overflow-wrap: anywhere;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 0.9;
  }

  .contact-line a {
    font-size: inherit;
    font-weight: 800;
    line-height: inherit;
    border-bottom: 1.5px solid currentColor;
    color: black;
    transition: color 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @media (hover: hover) {
    .contact-line a:hover {
      font-size: inherit;
      font-weight: 800;
      line-height: inherit;
      border-bottom: 1.5px solid currentColor;
      color: #afafaf;
      transition: color 0.14s cubic-bezier(0.47, 0, 0.745, 0.715);
    }
  }

  .contact-line a:active {
    color: #afafaf;
  }

  @media (max-width: 800px) {
    .container {
      gap: 0.75rem;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }
  }
</style>
