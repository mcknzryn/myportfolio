---
const currentPath = Astro.url.pathname;
const links = [
  { href: "/work/", label: "WORK" },
  { href: "/about/", label: "CV" },
  { href: "/contact/", label: "CONTACT" },
] as const;
---

<header class="site-header">
  <a href="/" class="site-title">McKenzie Ryan</a>

  <nav class="desktop-navigation" aria-label="Main navigation">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath.startsWith(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>

  <details class="mobile-menu">
    <summary>
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </summary>
    <nav class="mobile-navigation" aria-label="Mobile navigation">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={currentPath.startsWith(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => menu.removeAttribute("open"));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--header-height);
    padding-inline: var(--chrome-inline-padding);
    background: transparent;
  }

  :global(.layout-document) .site-header {
    position: fixed;
    inset: 0 0 auto;
  }

  .site-title {
    display: block;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -1px;
    text-align: left;
  }

  .desktop-navigation {
    position: absolute;
    inset-inline: var(--chrome-inline-padding);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    pointer-events: none;
  }

  .desktop-navigation a {
    display: block;
    padding-inline-end: 30px;
    font-size: 12px;
    font-weight: var(--font-weight-regular);
    line-height: 20px;
    text-align: right;
    pointer-events: auto;
  }

  .desktop-navigation a:first-child {
    grid-column: 2;
  }

  .desktop-navigation a:last-child {
    padding-inline-end: 0;
  }

  .desktop-navigation a:hover {
    color: blue;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .desktop-navigation a[aria-current="page"] {
    color: #afafaf;;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .site-title:hover {
    color: fuchsia;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 800px) {
    .site-header {
      align-items: flex-end;
      padding-block: max(0.5rem, env(safe-area-inset-top, 0px)) 0.5rem;
      border-bottom: 1px solid currentColor;
      color: #000;
      background: #fff;
    }

    .site-title {
      max-width: 8rem;
      font-size: 24px;
      line-height: 24px;
    }

    .mobile-menu {
      display: block;
    }

    .desktop-navigation {
      display: none;
    }

    .mobile-menu {
      margin-inline-start: auto;
    }

    .mobile-menu summary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      cursor: pointer;
      list-style: none;
      text-transform: uppercase;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-label {
      font-size: 12px;
    }

    .menu-icon {
      display: grid;
      gap: 4px;
      width: 20px;
    }

    .menu-icon i {
      display: block;
      height: 1px;
      background: currentColor;
      transition:
        transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 280ms ease;
    }

    .mobile-navigation {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      gap: 0.5rem;
      padding: 1rem var(--chrome-inline-padding) 0.75rem;
      border-bottom: 1px solid currentColor;
      background: #fff;
      box-shadow: 0 0.75rem 1rem rgb(0 0 0 / 8%);
    }

    .mobile-navigation a {
      padding-block: 0.25rem;
      font-size: 12px;
      line-height: 20px;
      text-align: right;
    }

    .mobile-navigation a:hover,
    .mobile-navigation a[aria-current="page"] {
      color: blue;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .mobile-menu[open] .menu-icon i:first-child {
      transform: translateY(5px) rotate(45deg);
    }

    .mobile-menu[open] .menu-icon i:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu[open] .menu-icon i:last-child {
      transform: translateY(-5px) rotate(-45deg);
    }
  }

  @media (min-width: 801px) and (max-width: 1024px) {
    .site-header {
      border-bottom: 1px solid currentColor;
      background: #fff;
    }
  }
</style>
