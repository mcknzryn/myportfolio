---
// This frontmatter runs during Astro's build/render step. It converts the
// canonical data from photos.ts into gallery HTML and, in development only,
// passes arrangement configuration to the browser through data-* attributes.

import { getImage, Image } from "astro:assets";
import {
  galleryFavorites,
  galleryPinned,
  workGalleryColumns,
  workPhotoColumns,
} from "../data/photos";

// `galleryColumns` is a local presentation name for three columns of complete
// PhotoRecord objects. `workGalleryColumns` above contains only their IDs.
const galleryColumns = workPhotoColumns;

const mobileImagesById = new Map(
  await Promise.all(
    galleryColumns.flat().map(
      async (photo) =>
        [
          photo.id,
          await getImage({
            src: photo.image,
            width: 800,
            widths: [320, 480, 640, 800],
            quality: 70,
            format: "webp",
          }),
        ] as const,
    ),
  ),
);

// Lightbox candidates are generated separately from the small gallery sources.
// Their URLs are written into data attributes, so the browser does not request
// any of them until a visitor chooses a photograph.
const lightboxImagesById = new Map(
  await Promise.all(
    galleryColumns.flat().map(async (photo) => {
      const maximumWidth = Math.min(photo.image.width, 3000);
      const widths = [800, 1200, 1600, 2000, 2400, 3000].filter(
        (width) => width <= maximumWidth,
      );
      if (!widths.includes(maximumWidth)) widths.push(maximumWidth);

      return [
        photo.id,
        await getImage({
          src: photo.image,
          width: maximumWidth,
          widths,
          quality: 82,
          format: "webp",
        }),
      ] as const;
    }),
  ),
);
---

<!--
  The data-gallery-* attributes are a bridge between two execution times.
  Astro serializes typed arrays to JSON text now; gallery-arrange.js can parse
  that text later in the browser. Production does not receive editor data.
-->
<section
  class="gallery"
  aria-label="Selected photography gallery"
  data-gallery-favorites={import.meta.env.DEV
    ? JSON.stringify(galleryFavorites)
    : undefined}
  data-gallery-pinned={import.meta.env.DEV
    ? JSON.stringify(galleryPinned)
    : undefined}
  data-gallery-columns={import.meta.env.DEV
    ? JSON.stringify(workGalleryColumns)
    : undefined}
  data-gallery-unplaced={import.meta.env.DEV ? "[]" : undefined}
>
  {
    galleryColumns.map((column) => (
      <div class="gallery-column">
        {column.map((photo) => {
          const mobileImage = mobileImagesById.get(photo.id)!;
          const lightboxImage = lightboxImagesById.get(photo.id)!;

          return (
            <figure class="gallery-item" data-image-id={photo.id}>
              <a
                class="gallery-image-link"
                href={lightboxImage.src}
                data-lightbox-trigger
                data-lightbox-src={lightboxImage.src}
                data-lightbox-srcset={lightboxImage.srcSet.attribute}
                data-lightbox-width={photo.image.width}
                data-lightbox-height={photo.image.height}
              >
                <picture>
                  <source
                    media="(max-width: 800px)"
                    srcset={mobileImage.srcSet.attribute}
                    sizes="30vw"
                    type="image/webp"
                  />
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    draggable={false}
                    width={1600}
                    widths={[320, 480, 640, 800, 1080, 1280, 1600]}
                    sizes="(max-width: 800px) 30vw, (max-width: 1600px) 28vw, 448px"
                    quality={82}
                    format="webp"
                    loading="lazy"
                  />
                </picture>
              </a>
            </figure>
          );
        })}
      </div>
    ))
  }
</section>

<dialog class="work-lightbox" data-lightbox aria-label="Expanded photograph">
  <div class="lightbox-surface" data-lightbox-surface>
    <div class="lightbox-image-area" data-lightbox-swipe-area>
      <img
        class="lightbox-image"
        data-lightbox-image
        alt=""
        draggable="false"
      />
    </div>
    <button
      class="lightbox-control lightbox-close"
      type="button"
      aria-label="Close expanded photograph"
      data-lightbox-close
      autofocus
    >
      <span aria-hidden="true">×</span>
    </button>
    <button
      class="lightbox-control lightbox-previous"
      type="button"
      aria-label="Previous photograph"
      data-lightbox-previous
    >
      <span aria-hidden="true">←</span>
    </button>
    <button
      class="lightbox-control lightbox-next"
      type="button"
      aria-label="Next photograph"
      data-lightbox-next
    >
      <span aria-hidden="true">→</span>
    </button>
  </div>
</dialog>

<!-- Reveal and lightbox are public enhancements; arrange is a DEV-only tool. -->
<script src="../scripts/gallery-reveal.js"></script>
<script src="../scripts/gallery-lightbox.js"></script>
{import.meta.env.DEV && <script src="../scripts/gallery-arrange.js" />}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-item {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #fff;
    break-inside: avoid;
    touch-action: pan-y;
  }

  .gallery-image-link {
    display: block;
    cursor: pointer;
  }

  .gallery-image-link:focus-visible {
    outline-offset: -3px;
  }

  .gallery-item :global(picture),
  .gallery-item :global(img) {
    display: block;
  }

  :global(html.js) .gallery-item :global(img):not(.is-revealed) {
    opacity: 0;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-item :global(img).is-reveal-animated {
    animation: gallery-image-reveal 900ms cubic-bezier(0.22, 1, 0.36, 1)
      var(--gallery-reveal-delay, 0ms) backwards;
    transition: none;
  }

  .gallery-item :global(img).is-revealed {
    opacity: 1;
  }

  .gallery.is-reveal-immediate .gallery-item :global(img) {
    animation: none;
    transition: none;
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  @keyframes gallery-image-reveal {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (max-width: 800px) {
    .gallery-item :global(img).is-reveal-animated {
      animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
    }
  }

  .gallery-item.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  :global(body.arrange-mode) .gallery-item {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(body.arrange-mode) .gallery-image-link {
    pointer-events: none;
  }

  :global(body.arrange-mode) .gallery {
    position: relative;
    display: grid;
    min-height: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  :global(body.arrange-mode) .gallery-column {
    position: relative;
    display: block;
    min-width: 0;
  }

  :global(body.arrange-mode) .gallery-item {
    width: 100%;
    margin: 0;
  }

  :global(.arrange-toolbar) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  :global(.arrange-favorite-button),
  :global(.arrange-pin-button) {
    position: absolute;
    top: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgb(255 255 255 / 90%);
    color: #000;
    cursor: pointer;
    font-family: var(--font-sans);
    line-height: 1;
  }

  :global(.arrange-favorite-button) {
    right: 0.5rem;
    font-size: 1.25rem;
    font-weight: var(--font-weight-regular);
  }

  :global(.arrange-pin-button) {
    left: 0.5rem;
    font-size: 1rem;
    font-weight: var(--font-weight-regular);
  }

  :global(.arrange-favorite-button.is-active),
  :global(.arrange-pin-button.is-active),
  :global(.arrange-favorite-button:hover),
  :global(.arrange-pin-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.gallery.is-overview) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  :global(.gallery.is-overview) .gallery-item {
    aspect-ratio: 1 / 1;
    margin: 0;
  }

  :global(.gallery.is-overview) .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.arrange-toolbar button) {
    padding: 0.5rem 0.75rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  :global(.arrange-toolbar button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-output) {
    width: min(100%, 42rem);
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid #999;
    background: #fafafa;
    color: #000;
    resize: vertical;
    font: 0.8rem/1.4 monospace;
  }

  .work-lightbox {
    --lightbox-transition-duration: 700ms;
    --lightbox-transition-easing: cubic-bezier(0.4, 0, 0.2, 1);

    width: 100vw;
    max-width: none;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: #000;
    opacity: 0;
    transition: opacity var(--lightbox-transition-duration)
      var(--lightbox-transition-easing);
  }

  .work-lightbox::backdrop {
    background: rgb(255 255 255 / 0%);
    transition: background-color var(--lightbox-transition-duration)
      var(--lightbox-transition-easing);
  }

  .work-lightbox.is-visible {
    opacity: 1;
  }

  .work-lightbox.is-visible::backdrop {
    background: rgb(255 255 255 / 94%);
  }

  .lightbox-surface {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .lightbox-image-area {
    display: flex;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding: max(4rem, calc(env(safe-area-inset-top, 0px) + 3rem))
      max(4.75rem, calc(env(safe-area-inset-right, 0px) + 4rem))
      max(4rem, calc(env(safe-area-inset-bottom, 0px) + 3rem))
      max(4.75rem, calc(env(safe-area-inset-left, 0px) + 4rem));
    touch-action: pan-y pinch-zoom;
  }

  .lightbox-surface.is-browser-zoomed .lightbox-image-area {
    touch-action: pan-x pan-y pinch-zoom;
  }

  .lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    opacity: 1;
    -webkit-user-drag: none;
    user-select: none;
    transition: opacity var(--lightbox-transition-duration)
      var(--lightbox-transition-easing);
  }

  .lightbox-image.is-loading {
    opacity: 0;
  }

  .lightbox-control {
    position: absolute;
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: rgb(255 255 255 / 92%);
    color: #000;
    cursor: pointer;
    font: 1.25rem/1 var(--font-sans);
  }

  .lightbox-control:hover {
    background: #000;
    color: #fff;
  }

  .lightbox-close {
    top: max(1rem, env(safe-area-inset-top, 0px));
    right: max(1rem, env(safe-area-inset-right, 0px));
    font-size: 1.5rem;
  }

  .lightbox-previous {
    top: 50%;
    left: max(1rem, env(safe-area-inset-left, 0px));
    transform: translateY(-50%);
  }

  .lightbox-next {
    top: 50%;
    right: max(1rem, env(safe-area-inset-right, 0px));
    transform: translateY(-50%);
  }

  :global(html.lightbox-open),
  :global(body.lightbox-open) {
    overflow: hidden;
  }

  :global(body.lightbox-open) {
    position: fixed;
    top: var(--lightbox-scroll-offset, 0);
    right: 0;
    left: 0;
    width: 100%;
  }

  @media (max-width: 800px) {
    .lightbox-image-area {
      padding: max(4rem, calc(env(safe-area-inset-top, 0px) + 3rem))
        max(0.75rem, env(safe-area-inset-right, 0px))
        max(4rem, calc(env(safe-area-inset-bottom, 0px) + 3rem))
        max(0.75rem, env(safe-area-inset-left, 0px));
    }

    .lightbox-previous,
    .lightbox-next {
      top: auto;
      bottom: max(1rem, env(safe-area-inset-bottom, 0px));
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-lightbox,
    .work-lightbox::backdrop,
    .lightbox-image {
      transition: none;
    }
  }
</style>
