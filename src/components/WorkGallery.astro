---
import { Image } from "astro:assets";
import {
  galleryFavorites,
  galleryPinned,
  workGalleryColumns,
  workPhotoColumns,
} from "../data/photos";

const galleryColumns = workPhotoColumns;
---

<section
  class="gallery"
  aria-label="Selected photography gallery"
  data-gallery-favorites={import.meta.env.DEV
    ? JSON.stringify(galleryFavorites)
    : undefined}
  data-gallery-pinned={import.meta.env.DEV
    ? JSON.stringify(galleryPinned)
    : undefined}
  data-gallery-columns={import.meta.env.DEV
    ? JSON.stringify(workGalleryColumns)
    : undefined}
  data-gallery-unplaced={import.meta.env.DEV ? "[]" : undefined}
>
  {
    galleryColumns.map((column) => (
      <div class="gallery-column">
        {column.map((photo) => (
          <figure class="gallery-item" data-image-id={photo.id}>
            <picture>
              <Image
                src={photo.image}
                alt={photo.alt}
                draggable={false}
                widths={[320, 480, 640, 800, 1080, 1280]}
                sizes="(max-width: 900px) 30vw, 28vw"
                quality={70}
                format="webp"
                loading="lazy"
              />
            </picture>
          </figure>
        ))}
      </div>
    ))
  }
</section>

<script src="../scripts/gallery-reveal.js"></script>
{import.meta.env.DEV && <script src="../scripts/gallery-arrange.js" />}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-item {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #fff;
    break-inside: avoid;
    touch-action: pan-y;
  }

  .gallery-item :global(picture),
  .gallery-item :global(img) {
    display: block;
  }

  .gallery-item :global(img) {
    width: 100%;
    height: auto;
    opacity: 1;
    transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-item :global(img).is-reveal-pending {
    opacity: 0;
  }

  .gallery-item :global(img).is-revealed {
    opacity: 1;
  }

  .gallery-item:hover :global(img) {
    opacity: 0.85;
  }

  .gallery-item.is-dragging {
    opacity: 0.45;
    cursor: grabbing;
  }

  :global(body.arrange-mode) .gallery-item {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  :global(body.arrange-mode) .gallery {
    position: relative;
    display: grid;
    min-height: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  :global(body.arrange-mode) .gallery-column {
    position: relative;
    display: block;
    min-width: 0;
  }

  :global(body.arrange-mode) .gallery-item {
    width: 100%;
    margin: 0;
  }

  :global(.arrange-toolbar) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  :global(.arrange-favorite-button),
  :global(.arrange-pin-button) {
    position: absolute;
    top: 0.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid #000;
    border-radius: 50%;
    background: rgb(255 255 255 / 90%);
    color: #000;
    cursor: pointer;
    font-family: var(--font-sans);
    line-height: 1;
  }

  :global(.arrange-favorite-button) {
    right: 0.5rem;
    font-size: 1.25rem;
    font-weight: var(--font-weight-regular);
  }

  :global(.arrange-pin-button) {
    left: 0.5rem;
    font-size: 1rem;
    font-weight: var(--font-weight-regular);
  }

  :global(.arrange-favorite-button.is-active),
  :global(.arrange-pin-button.is-active),
  :global(.arrange-favorite-button:hover),
  :global(.arrange-pin-button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.gallery.is-overview) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  :global(.gallery.is-overview) .gallery-item {
    aspect-ratio: 1 / 1;
    margin: 0;
  }

  :global(.gallery.is-overview) .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.arrange-toolbar button) {
    padding: 0.5rem 0.75rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  :global(.arrange-toolbar button:hover) {
    background: #000;
    color: #fff;
  }

  :global(.arrange-output) {
    width: min(100%, 42rem);
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid #999;
    background: #fafafa;
    color: #000;
    resize: vertical;
    font: 0.8rem/1.4 monospace;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item :global(img) {
      transition: none;
    }
  }
</style>
