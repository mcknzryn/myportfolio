---
// This component is the typed shell shared by every page. Its frontmatter runs
// while Astro renders HTML, not in the visitor's browser. Pages supply layout
// choices through Props; the component turns them into shared classes and markup.

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

// These project-authored union types list every permitted string. A page cannot
// accidentally request an unknown layout mode without a TypeScript error.
export type LayoutMode = "viewport" | "document";
export type ContentLayout =
  "default" | "centered-all" | "centered-mobile" | "centered-desktop";

// `Props` is Astro's conventional name for the input contract of a component.
// The `?` marks properties that callers may omit.
interface Props {
  title: string;
  mode: LayoutMode;
  contentLayout?: ContentLayout;
  description?: string;
}

// Destructuring extracts named values from Astro.props. The `=` expressions are
// defaults used only when the corresponding optional property was not supplied.
const {
  title,
  mode,
  contentLayout = "default",
  description = "The photography portfolio of McKenzie Ryan.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lgy6wgp.css" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {title === "Home" ? "McKenzie Ryan" : `${title} | McKenzie Ryan`}
    </title>
  </head>
  <body class={`layout-${mode}`} data-layout-mode={mode}>
    <div class="site-shell">
      <Header />
      <main
        id="main-content"
        class:list={["site-main", `content-layout-${contentLayout}`]}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  .site-shell {
    width: 100%;
    min-width: 0;
  }

  .layout-viewport .site-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100vh;
    height: 100svh;
    overflow: clip;
  }

  .layout-viewport .site-main {
    min-width: 0;
    min-height: 0;
  }

  .layout-document .site-shell {
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
    flex-direction: column;
  }

  .layout-document .site-main {
    flex: 1;
    padding-block-start: var(--header-height);
    padding-inline: var(--page-gutter);
  }

  .content-layout-centered-all {
    display: grid;
    align-items: center;
    align-items: safe center;
    justify-items: center;
    justify-items: safe center;
    text-align: center;
  }

  @media (max-width: 800px) {
    .content-layout-centered-mobile {
      display: grid;
      align-items: center;
      align-items: safe center;
      justify-items: center;
      justify-items: safe center;
      text-align: center;
    }
  }

  @media (min-width: 801px) {
    .content-layout-centered-desktop {
      display: grid;
      align-items: center;
      align-items: safe center;
      justify-items: center;
      justify-items: safe center;
      text-align: center;
    }
  }
</style>
