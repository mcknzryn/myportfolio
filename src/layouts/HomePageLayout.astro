---
import BaseLayout from "./BaseLayout.astro";
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/slideshow/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const gallery = await Promise.all(Object.entries(imageModules)
  .sort(([first], [second]) => first.localeCompare(second))
  .map(async ([path, module]) => {
    const filename = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
    const alt = filename.replace(/[-_]/g, " ");
    const mobileImage = await getImage({
      src: module.default,
      widths: [400, 640, 800, 1080, 1280],
      quality: 70,
      format: "webp",
    });

    return { image: module.default, mobileImage, alt };
  }));

const pageTitle = "Home Page";
---

<BaseLayout pageTitle={pageTitle} hidePageTitle={true} bodyClass="home-page">
  <main class="home-gallery" aria-label="Photography slideshow">
    <div class="gallery-stage" tabindex="0">
      {gallery.map((item, index) => (
        <figure class:list={["slide", { active: index === 0 }]}>
          <picture>
            <source
              media="(max-width: 800px)"
              srcset={item.mobileImage.srcSet.attribute}
              sizes="92vw"
              type="image/webp"
            />
            <Image
              src={item.image}
              alt={item.alt}
              sizes="(max-width: 800px) 100vw, 700px"
              loading={index === 0 ? "eager" : "lazy"}
            />
          </picture>
        </figure>
      ))}

      <button class="gallery-control previous" type="button" aria-label="Previous image">
        <span aria-hidden="true">‹</span>
      </button>
      <button class="gallery-control next" type="button" aria-label="Next image">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </main>
</BaseLayout>

<style>
  .home-gallery {
    height: calc(100svh - 8rem);
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 0 1.5rem 4rem;
  }

  .gallery-stage {
    position: relative;
    width: min(100%, 1000px);
    height: min(76svh, 820px);
    display: grid;
    place-items: center;
    outline: none;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .slide.active {
    opacity: 1;
  }

  .slide :global(img) {
    display: block;
    max-width: min(700px, calc(100vw - 10rem));
    max-height: calc(100svh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .slide :global(picture) {
    display: block;
  }

  .gallery-control {
    position: absolute;
    top: 0;
    z-index: 2;
    width: 28%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    font-size: 0;
    cursor: pointer;
    opacity: 0;
    transform: none;
  }

  .gallery-control.previous {
    left: 0;
  }

  .gallery-control.next {
    right: 0;
  }

  .gallery-control:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  @media (min-width: 801px) and (max-width: 1024px) {
    :global(body.home-page) {
      padding-top: 0;
      padding-bottom: 0;
    }

    .home-gallery {
      height: calc(100svh - var(--header-height) - var(--footer-height));
      margin-top: var(--header-height);
      padding: 0;
    }

    .gallery-stage {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .slide {
      inset: 1.5rem 0;
    }

    .slide :global(img) {
      max-width: 100%;
      max-height: calc(100svh - var(--header-height) - var(--footer-height) - 3rem);
    }
  }

  @media (min-width: 801px) {
    .gallery-control {
      width: var(--gallery-control-width, 0px);
    }

    .gallery-control.previous {
      left: var(--gallery-control-left, 0px);
    }

    .gallery-control.next {
      right: var(--gallery-control-right, 0px);
    }
  }

  @media (max-width: 800px) {
    .home-gallery {
      height: calc(100svh - var(--header-height) - var(--mobile-footer-clearance));
      margin-top: var(--header-height);
      padding: 0;
    }

    .gallery-stage {
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .slide {
      inset: var(--mobile-gallery-padding) 0;
    }

    .slide :global(img) {
      width: auto;
      height: auto;
      max-width: calc(100vw - var(--page-gutter) - var(--page-gutter));
      max-height: calc(100svh - var(--header-height) - var(--mobile-footer-clearance) - var(--mobile-gallery-padding) - var(--mobile-gallery-padding));
      object-fit: contain;
    }

    .gallery-control.previous {
      left: 0;
    }

    .gallery-control.next {
      right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .gallery-control {
      transition: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".gallery-stage");

  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>(".slide"));
    const previousButton = stage.querySelector<HTMLButtonElement>(".previous");
    const nextButton = stage.querySelector<HTMLButtonElement>(".next");
    let currentIndex = slides.findIndex((slide) => slide.classList.contains("active"));
    let autoplay: number | undefined;
    let resumeTimeout: number | undefined;
    let touchStartX = 0;
    const desktopQuery = window.matchMedia("(min-width: 801px)");
    const desktopControlMargin = 32;
    const desktopCenterGap = 160;

    const updateDesktopControls = () => {
      if (!desktopQuery.matches) {
        stage.style.removeProperty("--gallery-control-width");
        stage.style.removeProperty("--gallery-control-left");
        stage.style.removeProperty("--gallery-control-right");
        return;
      }

      const activeImage = slides[currentIndex]?.querySelector<HTMLImageElement>("img");
      if (!activeImage) return;

      const stageRect = stage.getBoundingClientRect();
      const imageRect = activeImage.getBoundingClientRect();
      const imageLeft = Math.max(0, imageRect.left - stageRect.left - desktopControlMargin);
      const imageRight = Math.max(0, stageRect.right - imageRect.right - desktopControlMargin);
      const controlWidth = Math.max(
        0,
        Math.min(
          imageRect.width / 2 + desktopControlMargin - desktopCenterGap / 2,
          stageRect.width / 2,
        ),
      );

      stage.style.setProperty("--gallery-control-width", `${controlWidth}px`);
      stage.style.setProperty("--gallery-control-left", `${imageLeft}px`);
      stage.style.setProperty("--gallery-control-right", `${imageRight}px`);
    };

    const scheduleDesktopControlUpdate = () => window.requestAnimationFrame(updateDesktopControls);

    const showSlide = (nextIndex: number) => {
      if (slides.length === 0) return;
      currentIndex = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => slide.classList.toggle("active", index === currentIndex));
      scheduleDesktopControlUpdate();
    };

    const startAutoplay = () => {
      if (slides.length > 1 && autoplay === undefined) {
        autoplay = window.setInterval(() => showSlide(currentIndex + 1), 2500);
      }
    };

    const stopAutoplay = () => {
      if (autoplay !== undefined) {
        window.clearInterval(autoplay);
        autoplay = undefined;
      }
    };

    const resumeAutoplayAfterClick = () => {
      stopAutoplay();

      if (resumeTimeout !== undefined) window.clearTimeout(resumeTimeout);
      resumeTimeout = window.setTimeout(() => {
        resumeTimeout = undefined;
        startAutoplay();
      }, 1000);
    };

    previousButton?.addEventListener("click", () => {
      showSlide(currentIndex - 1);
      resumeAutoplayAfterClick();
    });

    nextButton?.addEventListener("click", () => {
      showSlide(currentIndex + 1);
      resumeAutoplayAfterClick();
    });

    stage.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showSlide(currentIndex - 1);
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        showSlide(currentIndex + 1);
      }
    });

    stage.addEventListener("focusin", stopAutoplay);
    stage.addEventListener("focusout", (event) => {
      if (!stage.contains(event.relatedTarget as Node | null)) startAutoplay();
    });

    stage.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? 0;
      stopAutoplay();
    }, { passive: true });

    stage.addEventListener("touchend", (event) => {
      const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
      const distance = touchEndX - touchStartX;

      if (Math.abs(distance) > 40) showSlide(currentIndex + (distance < 0 ? 1 : -1));
      startAutoplay();
    }, { passive: true });

    slides.forEach((slide) => {
      slide.querySelector<HTMLImageElement>("img")?.addEventListener("load", scheduleDesktopControlUpdate);
    });
    window.addEventListener("resize", scheduleDesktopControlUpdate);
    desktopQuery.addEventListener("change", scheduleDesktopControlUpdate);
    scheduleDesktopControlUpdate();
    startAutoplay();
  }
</script>
